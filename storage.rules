rules_version = '2';

// Solo hay logos de comercio. Los lee cualquiera (salen en las tarjetas); los sube su dueño,
// ya reducidos en el navegador a 256 px en WebP (JPEG si el navegador no sabe hacer WebP).
service firebase.storage {
  match /b/{bucket}/o {
    match /logos/{uid}/{file} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 100 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
    }
  }
}
