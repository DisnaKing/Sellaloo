{
  "name": "sellaloo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "postinstall": "npm --prefix functions install --no-audit --no-fund",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc && npm --prefix functions run typecheck",
    "test": "vitest run --project unit --passWithNoTests && npm --prefix functions test",
    "test:rules": "firebase emulators:exec --project demo-sellaloo --only firestore,storage \"vitest run --project rules\"",
    "test:emulator": "firebase emulators:exec --project demo-sellaloo --only auth,firestore,storage \"vitest run --project rules && npm --prefix functions run test:emulator\"",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-sellaloo --import=.emulator-data --export-on-exit=.emulator-data",
    "seed": "tsx scripts/seed.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "firebase": "^12.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
