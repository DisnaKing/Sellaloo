rules_version = '2';

// Las escrituras de sellos, tarjetas, visitas y QR solo las hacen las Cloud Functions (Admin SDK,
// que se salta estas reglas). Desde el cliente solo se escribe el perfil propio, los datos
// básicos del comercio y su programa (el dueño o un admin), y `active` (solo un admin). Todo lo que no aparece aquí está denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Los documentos de un comercio llevan `ownerUid` para no tener que leer el comercio.
    function ownsDoc() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownerOrAdmin() {
      return isAdmin() || ownsDoc();
    }

    // El admin además activa o desactiva el comercio (`extra` = ['active']).
    function validBusinessUpdate(extra) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'type', 'logoUrl', 'timezone', 'dailyVisitLimit'].concat(extra))
        && d.active is bool
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.type is string && d.type.size() <= 40
        && (d.logoUrl == null || (d.logoUrl is string && d.logoUrl.size() <= 500))
        && d.timezone is string && d.timezone.size() >= 3 && d.timezone.size() <= 64
        && (d.dailyVisitLimit == null
          || (d.dailyVisitLimit is int && d.dailyVisitLimit >= 1 && d.dailyVisitLimit <= 20));
    }

    // Las tarjetas en curso no cambian: copian sellos y premio al crearse.
    // Los límites de sellos son los de `MIN_STAMPS_REQUIRED` y `MAX_STAMPS_REQUIRED`.
    function validProgramUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['stampsRequired', 'rewardDescription', 'stampExpiryMonths'])
        && d.stampsRequired is int && d.stampsRequired >= 2 && d.stampsRequired <= 20
        && d.rewardDescription is string && d.rewardDescription.size() >= 1
        && d.rewardDescription.size() <= 80
        && (d.stampExpiryMonths == null
          || (d.stampExpiryMonths is int && d.stampExpiryMonths >= 1 && d.stampExpiryMonths <= 24));
    }

    // `phoneVerified` solo es cierto si el teléfono es el mismo con el que se entró por SMS.
    // `email` solo puede ser el de la cuenta.
    function validCustomer() {
      let d = request.resource.data;
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && (d.phone == null || (d.phone is string && d.phone.matches('^\\+[1-9][0-9]{6,14}$')))
        && d.phoneVerified == (d.phone != null
          && request.auth.token.get('phone_number', null) == d.phone)
        && (d.email == null || d.email == request.auth.token.get('email', null));
    }

    match /businesses/{businessId} {
      allow read: if ownerOrAdmin();
      allow update: if (ownsDoc() && validBusinessUpdate([])) || (isAdmin() && validBusinessUpdate(['active']));

      match /programs/{programId} {
        allow read: if ownerOrAdmin();
        allow update: if ownerOrAdmin() && validProgramUpdate();
      }
      match /members/{memberId} {
        allow read: if ownerOrAdmin();
      }
      match /stats/{statId} {
        allow read: if ownerOrAdmin();
      }
    }

    match /customers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'phoneVerified', 'privacyAcceptedAt', 'privacyVersion', 'createdAt'])
        && request.resource.data.keys().hasAll(
          ['name', 'email', 'phone', 'phoneVerified', 'privacyAcceptedAt', 'privacyVersion', 'createdAt'])
        && validCustomer()
        && request.resource.data.privacyAcceptedAt == request.time
        && request.resource.data.privacyVersion is string
        && request.resource.data.privacyVersion.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'phone', 'phoneVerified'])
        && validCustomer();
    }

    match /cards/{cardId} {
      allow read: if ownerOrAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
    }

    match /qrTokens/{token} {
      allow read: if ownerOrAdmin();
    }

    match /visits/{visitId} {
      allow read: if ownerOrAdmin();
    }

    match /dailyVisits/{id} {
      allow read: if isAdmin();
    }
  }
}
