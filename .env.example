# Configuración web de Firebase (es pública). Sin este fichero, la app usa demo-sellaloo y los emuladores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Clave de sitio de reCAPTCHA Enterprise para App Check. Vacía: sin App Check (emuladores).
VITE_APPCHECK_SITE_KEY=
# Origen del QR. Vacío: el de la página. Para probar con el móvil: http://<IP del PC>:5173
VITE_PUBLIC_ORIGIN=
